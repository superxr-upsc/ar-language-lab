    m_Localized: Home
    m_Metadata:
      m_Items: []
  - m_Id: 20307853795557376
    m_Localized: 'Learn to recognize common objects at home and understand simple
      spatial relationships.

'
    m_Metadata:
      m_Items: []
  - m_Id: 20307891829506048
    m_Localized: 'Find the object you can sit on.

'
    m_Metadata:
      m_Items: []
  - m_Id: 20307946326097920
    m_Localized: 'Find the object you sleep on.

'
    m_Metadata:
      m_Items: []
  - m_Id: 20307949824147456
    m_Localized: 'Find the object you can look outside through.

'
    m_Metadata:
      m_Items: []
  - m_Id: 20307951912910848
    m_Localized: 'Place the chair next to the table.

'
    m_Metadata:
      m_Items: []
  - m_Id: 20307953829707776
