  m_TableData:
  - m_Id: 13865330399150080
    m_Localized: "G\u0103se\u0219te fructul ro\u0219u mic."
    m_Metadata:
      m_Items: []
  - m_Id: 14282447372058624
    m_Localized: "Pune banana l\xE2ng\u0103 m\u0103r."
    m_Metadata:
      m_Items: []
  - m_Id: 14282754588049408
    m_Localized: "Pune portocala \xEEn dreapta m\u0103rului.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 14283274211983360
    m_Localized: "Pune c\u0103p\u0219una \xEEn st\xE2nga bananei.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 16675303638335488
    m_Localized: 'Camera Auto-Focus :'
    m_Metadata:
      m_Items: []
  - m_Id: 16675467371380736
    m_Localized: 'Limba :'
    m_Metadata:
      m_Items: []
  - m_Id: 20312949757476864
    m_Localized: "C\u0103p\u0219un\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 20312924818145280
    m_Localized: "Banan\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 20312754273550336
    m_Localized: "M\u0103r"
    m_Metadata:
      m_Items: []
  - m_Id: 12797029279498240
    m_Localized: Fructe
    m_Metadata:
      m_Items: []
  - m_Id: 12797116785262592
    m_Localized: "\xCEnva\u021B\u0103 s\u0103 recuno\u0219ti patru fructe de baz\u0103
      \u0219i s\u0103 urmezi instruc\u021Biuni spa\u021Biale simple."
    m_Metadata:
      m_Items: []
  - m_Id: 10492190352637952
    m_Localized: "G\u0103se\u0219te fructul ro\u0219u."
    m_Metadata:
      m_Items: []
  - m_Id: 14280925196222464
    m_Localized: "G\u0103se\u0219te fructul galben."
    m_Metadata:
      m_Items: []
  - m_Id: 20313009102684160
    m_Localized: "Portocal\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 20313814539075584
    m_Localized: Scaun
    m_Metadata:
      m_Items: []
  - m_Id: 20313850211631104
    m_Localized: "Mas\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 20313886030987264
    m_Localized: Canapea
    m_Metadata:
      m_Items: []
  - m_Id: 20313908470513664
    m_Localized: Pat
    m_Metadata:
      m_Items: []
  - m_Id: 20313947896971264
    m_Localized: "Fereastr\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 20313980608348160
    m_Localized: "Can\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 20313998618689536
    m_Localized: "Lingur\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 20314017518223360
    m_Localized: "Fierb\u0103tor"
