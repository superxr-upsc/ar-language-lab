  - m_Id: 20307817955229696
    m_Localized: "\u0414\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 20307853795557376
    m_Localized: "\u041D\u0430\u0443\u0447\u0438\u0441\u044C \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0432\u0430\u0442\u044C
      \u043E\u0431\u044B\u0447\u043D\u044B\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
      \u0434\u043E\u043C\u0430 \u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C
      \u043F\u0440\u043E\u0441\u0442\u044B\u0435 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 20307891829506048
    m_Localized: "\u041D\u0430\u0439\u0434\u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442,
      \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u043C\u043E\u0436\u043D\u043E
      \u0441\u0438\u0434\u0435\u0442\u044C.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 20307946326097920
    m_Localized: "\u041D\u0430\u0439\u0434\u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442,
      \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u043C\u043E\u0436\u043D\u043E
      \u0441\u043F\u0430\u0442\u044C.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 20307949824147456
    m_Localized: "\u041D\u0430\u0439\u0434\u0438 \u043E\u0431\u044A\u0435\u043A\u0442,
      \u0447\u0435\u0440\u0435\u0437 \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043C\u043E\u0436\u043D\u043E
      \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430\u0440\u0443\u0436\u0443.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 20307951912910848
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u0441\u0442\u0443\u043B
      \u0440\u044F\u0434\u043E\u043C \u0441\u043E \u0441\u0442\u043E\u043B\u043E\u043C.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 20307953829707776
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u0441\u0442\u043E\u043B
      \u0441\u043F\u0440\u0430\u0432\u0430 \u043E\u0442 \u0441\u0442\u0443\u043B\u0430.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 20307955503235072
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C \u0434\u0438\u0432\u0430\u043D
      \u043F\u043E\u0434 \u043E\u043A\u043D\u043E\u043C.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 20307957063516160
    m_Localized: "\u0420\u0430\u0441\u0441\u0442\u0430\u0432\u044C \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
      \u043E\u0442 \u0441\u0430\u043C\u043E\u0433\u043E \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0433\u043E
      \u043A \u0441\u0430\u043C\u043E\u043C\u0443 \u0431\u043E\u043B\u044C\u0448\u043E\u043C\u0443.\r\n{Objects}"
    m_Metadata:
      m_Items:
      - rid: 2027872775275544660
  - m_Id: 20307958636380160
    m_Localized: "\u041D\u0430\u0439\u0434\u0438 \u043C\u044F\u0433\u043A\u0443\u044E
      \u043C\u0435\u0431\u0435\u043B\u044C, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u043C\u043E\u0436\u043D\u043E \u0441\u0438\u0434\u0435\u0442\u044C.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 20307960284741632
    m_Localized: "\u0420\u0430\u0441\u0441\u0442\u0430\u0432\u044C \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
      \u043E\u0442 \u0441\u0430\u043C\u043E\u0433\u043E \u043D\u0438\u0437\u043A\u043E\u0433\u043E
      \u043A \u0441\u0430\u043C\u043E\u043C\u0443 \u0432\u044B\u0441\u043E\u043A\u043E\u043C\u0443.\r\n{Objects}"
    m_Metadata:
